<?js
import { readFile } from 'node:fs/promises'
import { securePage } from './_headers.mjs'
import { head, header, footer, codeBlock, icon } from './_site.cow'
securePage(res)
res.setHeader('cache-control', 'no-store')
const greetingSource = (await readFile(__dirname + '/_welcome.cow', 'utf8')).trim()
const typedGreetingSource = greetingSource.replace('<?js', '<?ts').replace("let name =", "let name: string =")
const features = [
  { icon: 'form', title: 'Forms & uploads', text: 'Read submitted fields and uploaded files from an HTML form.', link: 'forms' },
  { icon: 'cookie', title: 'Cookies & sessions', text: 'Remember preferences and keep people signed in.', link: 'sessions' },
  { icon: 'database', title: 'SQLite', text: 'Store data and query it with SQL. Nothing extra to install.', link: 'sqlite' },
  { icon: 'file-json', title: 'JSON, files & streams', text: 'Send JSON, stream a response, or offer a download.', link: 'responses' }
]
const runtimes = [{id:'node',name:'Node.js',logo:'nodejs'},{id:'bun',name:'Bun',logo:'bun'},{id:'nub',name:'Nub',logo:'nub'},{id:'deno',name:'Deno',logo:'denojs'}]
const routes = [['index.cow', '/'], ['about.cow', '/about'], ['blog/index.cow', '/blog/']]
const helperSource = "<?js\nexport function greet(name) {\n  return `Hello, ${name}!`\n}"
const pageSource = "<?js\nimport { greet } from './_greetings.cow'\n?>\n<h1><?= h(greet('Clover')) ?></h1>"
?>
<!doctype html>
<html lang="en">
<head>
  <?= head('Cow — a web runtime for JavaScript and TypeScript', 'Cow is a web runtime for JavaScript and TypeScript. Write server-side code inside your HTML, use npm packages, and run it with no build step, framework, or configuration.') ?>
  <link rel="stylesheet" href="/assets/home-alt.css">
  <script type="module" src="/assets/home-alt.mjs"></script>
</head>
<body class="home-alt">
<?= header() ?>
<main id="main">
  <section class="alt-hero wrap" aria-labelledby="alt-title">
    <p class="alt-intro">A web runtime for JavaScript and TypeScript.</p>
    <h1 id="alt-title"><span class="alt-phrase">No build.</span> <span class="alt-phrase">No framework.</span><br><span class="alt-marked">No bull.<svg viewBox="0 0 510 30" preserveAspectRatio="none" aria-hidden="true"><path d="M5 19 Q240 -2 501 12 M37 27 Q235 8 450 24"/></svg></span></h1>
    <p class="alt-lede">Write server code inside your HTML, save the file, and refresh. Routing, forms, sessions, and a database come built in.</p>
    <div class="alt-actions"><a class="button button-primary" href="/docs/get-started">Get moooving <?= icon('arrow-line-right', 20) ?></a><a class="text-link" href="#demo">Try it out <?= icon('arrow-line-down', 20) ?></a></div>
    <p class="alt-release">Free-range and open source · Still growing</p>
  </section>

  <section class="alt-demo wrap" id="demo" aria-labelledby="alt-demo-title">
    <div class="alt-demo-heading"><h2 id="alt-demo-title">One file. Front to back.</h2><p>The form and the code that answers it, together.</p></div>
    <div class="alt-demo-frame">
      <div class="alt-wave" aria-hidden="true"><img src="/assets/doodles/cow-wave.svg" alt="" width="195" height="202"></div>
      <div class="alt-editor">
        <div class="pane-toolbar"><span class="filename"><?= icon('cow-file', 16) ?>welcome.cow</span><div class="example-switch js-only" role="group" aria-label="Example language"><button type="button" data-language="js" aria-pressed="true" aria-controls="source-js">JavaScript</button><button type="button" data-language="ts" aria-pressed="false" aria-controls="source-ts">TypeScript</button></div></div>
        <div id="source-js"><?= codeBlock(greetingSource) ?></div>
        <div id="source-ts" hidden><?= codeBlock(typedGreetingSource) ?></div>
        <div class="alt-code-footer"><span><span id="language-label">JavaScript</span> + HTML</span><button class="copy-button js-only" type="button" id="copy-example">Copy code <?= icon('copy', 16) ?></button></div>
      </div>
      <div class="alt-browser">
        <div class="alt-browser-bar"><?= icon('browser', 18) ?><a href="/welcome" title="Open the working example">/welcome <?= icon('arrow-line-up-right', 20) ?></a><span class="alt-live"><?= icon('checkmark', 14) ?>Live</span></div>
        <div class="alt-demo-output" data-demo-output>
          <?js await include('./_welcome.cow') ?>
        </div>
        <p class="alt-demo-hint" id="alt-demo-status" role="status">Give Cow a name to say hello to.</p>
      </div>
    </div>
    <div class="alt-demo-bottom"><p>The code runs on the server. The HTML goes to the browser.</p><a class="text-link" href="/docs/language">See how pages are written <?= icon('arrow-line-right', 20) ?></a></div>
  </section>

  <section class="alt-routes wrap" aria-labelledby="alt-routes-title">
    <div class="alt-section-copy"><h2 id="alt-routes-title">Your files<br>know the way.</h2><p>Pages get their URLs from your files and folders. Add a Cow file to your site and it’s ready to visit. No router to set up.</p><a class="text-link" href="/docs/routing">How pages work <?= icon('arrow-line-right', 20) ?></a></div>
    <div class="alt-route-map">
      <div class="alt-route-labels"><span><?= icon('folder', 20) ?>In your site</span><span>In your browser</span></div>
      <?js for (const [file, url] of routes) { ?>
      <div class="alt-route-pair"><span><?= icon('cow-file', 22) ?><code><?= h(file) ?></code></span><span class="alt-route-line" aria-hidden="true"><?= icon('arrow-line-right', 20) ?></span><code class="alt-route-url"><?= h(url) ?></code></div>
      <?js } ?>
      <div class="alt-run-line"><span aria-hidden="true">$</span><code id="alt-run-command">cow site</code><button type="button" class="copy-button js-only" data-copy="alt-run-command" aria-label="Copy start command">Copy <?= icon('copy', 16) ?></button></div>
    </div>
  </section>

  <section class="alt-barn" aria-labelledby="alt-barn-title"><div class="mascot-clip alt-barn-peek" aria-hidden="true"><img src="/assets/doodles/cow-peek.svg" alt="" width="170" height="186" loading="lazy"></div><img class="alt-barn-doodle" src="/assets/doodles/cow-barn.svg" alt="" width="1284" height="1272" loading="lazy" aria-hidden="true"><div class="wrap">
    <div class="alt-section-heading"><p class="alt-pill"><?= icon('checkmark', 14) ?>Essentials built in</p><h2 id="alt-barn-title">A well-stocked barn.</h2><p>The everyday tools for building web apps come with Cow.<br>Batteries included. Hay optional.</p></div>
    <div class="alt-features">
      <?js for (const feature of features) { ?>
      <a class="alt-feature" href="/docs/<?= h(feature.link) ?>"><span class="alt-feature-icon"><?= icon(feature.icon, 22) ?></span><h3><?= h(feature.title) ?> <?= icon('arrow-line-up-right', 20) ?></h3><p><?= h(feature.text) ?></p></a>
      <?js } ?>
    </div>
  </div></section>

  <section class="alt-grow wrap" aria-labelledby="alt-grow-title">
    <div class="alt-module-example"><div class="alt-helper-file"><?= codeBlock(helperSource, '_greetings.cow') ?></div><div class="alt-page-file"><?= codeBlock(pageSource, 'index.cow') ?></div></div>
    <div class="alt-section-copy"><h2 id="alt-grow-title">Start small.<br>Room to graze.</h2><p>One file is a fine place to start. As your app grows, share code with modules and reuse HTML with includes.</p><a class="text-link" href="/docs/modules">How modules and includes work <?= icon('arrow-line-right', 20) ?></a><p class="alt-php-note">Coming from PHP? <a href="/why/php"><span>You’ll feel at home.</span><?= icon('arrow-line-right', 16) ?></a></p></div>
  </section>

  <div class="alt-familiar wrap">
    <section aria-labelledby="alt-language-title"><div class="alt-language-marks"><a href="/docs/language" aria-label="JavaScript support"><img src="/assets/brands/javascript.svg" alt="JavaScript" width="68" height="68" loading="lazy"></a><a href="/docs/language#typescript" aria-label="TypeScript support"><img src="/assets/brands/typescript.svg" alt="TypeScript" width="68" height="68" loading="lazy"></a></div><h2 id="alt-language-title">Speak your language.</h2><p>JavaScript or TypeScript, in pages and modules.<br>Cow runs either without a separate build step.</p><a class="text-link" href="/docs/language">See JavaScript and TypeScript support <?= icon('arrow-line-right', 20) ?></a></section>
    <section aria-labelledby="alt-packages-title"><a class="alt-npm-mark" href="/docs/compatibility#packages" aria-label="npm package support"><img src="/assets/brands/npm.svg" alt="npm" width="110" height="110" loading="lazy"></a><h2 id="alt-packages-title">Bring the herd.</h2><p>Keep using familiar npm packages.<br>Install them, then import them in your Cow code.</p><a class="text-link" href="/docs/compatibility#packages">See package support <?= icon('arrow-line-right', 20) ?></a></section>
  </div>

  <section class="alt-runtime" aria-labelledby="alt-runtime-title"><img class="alt-hay-doodle" src="/assets/doodles/cow-hay.svg" alt="" width="1212" height="1024" loading="lazy" aria-hidden="true"><div class="wrap">
    <div class="alt-section-heading"><h2 id="alt-runtime-title">Pick your pasture.</h2><p>Run Cow with the JavaScript runtime you prefer.</p></div>
    <div class="alt-runtime-options" role="group" aria-label="Choose a runtime">
      <?js for (const runtime of runtimes) { ?>
      <button class="alt-runtime-option" type="button" data-runtime="<?= h(runtime.id) ?>" aria-pressed="<?= runtime.id === 'node' ? 'true' : 'false' ?>" aria-controls="runtime-command"><img src="/assets/brands/<?= h(runtime.logo) ?>.svg" alt="" width="56" height="56" loading="lazy"><strong><?= h(runtime.name) ?></strong></button>
      <?js } ?>
    </div>
    <div class="alt-runtime-command"><span aria-hidden="true">$</span><code id="runtime-command" aria-live="polite">cow site --runtime node</code><button class="copy-button js-only" type="button" data-copy="runtime-command" aria-label="Copy runtime command">Copy <?= icon('copy', 16) ?></button></div>
    <a class="alt-runtime-link" href="/docs/runtimes">Runtime support and setup <?= icon('arrow-line-right', 20) ?></a>
  </div></section>

  <section class="alt-examples wrap" aria-labelledby="alt-examples-title">
    <div class="alt-section-copy"><h2 id="alt-examples-title">Fresh from<br>the field.</h2><p>Take a look around a working Cow app.<br>See how the pieces fit together.</p><a class="text-link" href="/examples/">Browse examples <?= icon('arrow-line-right', 20) ?></a></div>
    <div class="alt-example-list"><div class="alt-curious" aria-hidden="true"><img src="/assets/doodles/cow-curious.svg" alt="" width="159" height="207" loading="lazy"></div><a href="/examples/mininews"><div><h3>MiniNews</h3><p>A news editor in one file. Write, save a draft, publish.</p></div><?= icon('arrow-line-up-right', 20) ?></a><a href="/examples/forum"><div><h3>Forum</h3><p>Accounts, discussions, replies, and moderation.</p></div><?= icon('arrow-line-up-right', 20) ?></a><a href="/docs/forms"><div><h3>Your first form</h3><p>Read a name from a form and say hello.</p></div><?= icon('arrow-line-up-right', 20) ?></a></div>
  </section>

  <section class="alt-start wrap" id="get-cow" aria-labelledby="alt-start-title"><h2 id="alt-start-title">Got an idea?<br>Let it <span>loose.</span></h2><p>Make your first page. See where it takes you.</p><div class="alt-actions"><a class="button button-primary" href="/docs/get-started">Get moooving <?= icon('arrow-line-right', 20) ?></a><a class="text-link" href="https://github.com/usecow/cow" target="_blank" rel="noopener noreferrer">Find Cow on GitHub <?= icon('arrow-line-up-right', 20) ?></a></div><p class="alt-release">Free, open source, and still growing.</p></section>
</main>
<?= footer() ?>
</body>
</html>
