<!doctype html><html lang="en"><head><?= head('Examples — Cow', 'Cow examples: forms, databases, a news editor, and a forum.') ?></head><body><?= header('examples') ?>
<main id="main" class="directory-page wrap"><header class="page-intro"><h1>Have a little Cow.</h1><p>Try a small example or explore a whole application.</p></header>
<div class="directory-grid"><?js for (const page of examples) { ?><a class="directory-card" href="/examples/<?= h(page.slug) ?>"><h2><?= h(page.title) ?> <?= icon('arrow-line-up-right', 18) ?></h2><p><?= h(page.description) ?></p></a><?js } ?>
<a class="directory-card" href="/docs/forms"><h2>Your first form <?= icon('arrow-line-up-right', 18) ?></h2><p>Read a name from a submitted form and greet the visitor.</p></a>
