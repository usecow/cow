<?js
import { escapeHtml, raw } from 'cow:web'
import { icon as renderIcon } from './assets/ui-icons.mjs'
import { highlight } from '../../lib/highlight.mjs'
import { fontPreviewEnabled } from './_headers.mjs'
export const icon = (...args) => raw(renderIcon(...args))
export const escape = escapeHtml

export function codeBlock(source, filename = '', id = '') {
  // Terminal transcripts and PHP comparisons stay plain; JS/TS files are pure
  // code; everything else highlights as a Cow template (HTML included).
  const colored = /^(terminal|php)\b/i.test(filename) ? escape(source)
    : highlight(String(source), { filename, code: /\.(m?js|ts)$/i.test(filename) })
  return raw(`<div class="code-window">${filename ? `<div class="pane-toolbar"><span class="filename">${icon(/\.cow$/.test(filename) ? 'cow-file' : /^terminal$/i.test(filename) ? 'terminal' : 'file-code', 16)}${escape(filename)}</span>${id ? `<button type="button" class="copy-button js-only" data-copy="${escape(id)}" aria-label="Copy ${escape(filename)}">Copy ${icon('copy', 16)}</button>` : ''}</div>` : ''}<pre${id ? ` id="${escape(id)}"` : ''}><code>${colored}</code></pre></div>`)
}

export function head(title, description) {
  return raw(`<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#ffffff"><meta name="description" content="${escape(description)}"><title>${escape(title)}</title><link rel="icon" href="/assets/cow-mark.svg" type="image/svg+xml" sizes="any"><link rel="preload" href="/assets/lexend-latin.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/funnel-sans-latin.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/site.css"><script type="module" src="/assets/site.mjs"></script>${fontPreviewEnabled() ? '<script type="module" src="/assets/font-picker.mjs"></script>' : ''}`)
}

export function header(active = '') {
  return raw(`<a class="skip-link" href="#main">Skip to content</a><header class="site-header wrap"><a class="wordmark" href="/" aria-label="Cow home"><img src="/assets/cow-mark.svg" alt="" width="42" height="42"><span>Cow</span></a><nav aria-label="Main navigation">${[['/why/','Why Cow?','why'],['/docs/','Docs','docs'],['/examples/','Examples','examples']].map(([url,label,key])=>`<a href="${url}"${active===key ? ' aria-current="page"' : ''}>${label}</a>`).join('')}<a class="github-link" href="https://github.com/usecow" target="_blank" rel="noopener noreferrer">GitHub ${icon('arrow-line-up-right', 20)}</a></nav><a class="button button-primary nav-cta" href="/docs/get-started">Get Cow ${icon('arrow-line-right', 20)}</a></header>`)
}

export function footer() {
  return raw(`<footer class="site-footer"><div class="wrap footer-inner"><img class="footer-cow" src="/assets/doodles/cow-rest.svg" alt="" width="208" height="106" loading="lazy" aria-hidden="true"><div class="footer-top"><div class="footer-brand"><a class="wordmark" href="/" aria-label="Cow home"><span class="footer-mark"><img src="/assets/cow-mark.svg" alt="" width="44" height="44"></span><span>Cow</span></a></div><nav aria-label="Learn"><h2>Learn</h2><a href="/docs/get-started">Get started</a><a href="/docs/">Documentation</a><a href="/examples/">Examples</a><a href="/docs/reference">API reference</a></nav><nav aria-label="Compare"><h2>Compare</h2><a href="/why/">Why Cow?</a><a href="/why/express">Cow vs Express</a><a href="/why/hono">Cow vs Hono</a><a href="/why/php">Coming from PHP</a></nav><nav aria-label="Project"><h2>Project</h2><a href="https://github.com/usecow" target="_blank" rel="noopener noreferrer">GitHub ${icon('arrow-line-up-right', 18)}</a><a href="/docs/runtimes">Runtimes</a><a href="/docs/compatibility">What's supported</a><a href="/assets/cow-mark.svg" download="cow-mark.svg">Brand mark ${icon('arrow-line-down', 20)}</a></nav><img class="footer-walk" src="/assets/doodles/cow-behind.svg" alt="" width="290" height="256" loading="lazy" aria-hidden="true"></div><div class="footer-bottom"><span>Open source. MIT licensed. Made with Cow.</span><a href="#main">Back to top ${icon('arrow-line-up', 20)}</a></div></div></footer><p class="sr-only" id="copy-status" role="status"></p>`)
}
