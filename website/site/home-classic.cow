<?js
import { securePage, annotationPreviewEnabled } from './_headers.mjs'
import { head, header, footer, icon } from './_site.cow'
securePage(res)
const annotationPreview = annotationPreviewEnabled()
const runtimes = [{id:'node',name:'Node.js',logo:'nodejs'},{id:'bun',name:'Bun',logo:'bun'},{id:'nub',name:'Nub',logo:'nub'},{id:'deno',name:'Deno',logo:'denojs'}]
const features = [
 {title:'Forms & uploads',text:'Read submitted fields and uploaded files from an HTML form.',link:'forms'},
 {title:'Cookies & sessions',text:'Keep people signed in and remember their preferences.',link:'sessions'},
 {title:'SQLite',text:'Store data and query it with SQL.',link:'sqlite'},
 {title:'Files & responses',text:'Send JSON, stream a response, or offer a file download.',link:'responses'},
 {title:'Cow modules',text:'Import reusable code and share it across your application.',link:'modules'},
 {title:'TypeScript',text:'Use TypeScript in your pages and modules without a build step.',link:'language#typescript'}
]
?>
<!doctype html>
<html lang="en"><head><?= head('Cow — a web runtime for JavaScript and TypeScript', 'Cow is a web runtime for JavaScript and TypeScript. Write server-side code inside your HTML, use npm packages, and run it with no build step, framework, or configuration.') ?><meta name="robots" content="noindex"></head>
<body>
<?= header() ?>
<main id="main">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title"><span class="hero-phrase">No build.</span> <span class="hero-phrase">No framework.</span><br><span class="marked-word">No bull.<svg viewBox="0 0 510 30" preserveAspectRatio="none" aria-hidden="true"><path d="M5 19 Q240 -2 501 12 M37 27 Q235 8 450 24"/></svg></span></h1>
      <p class="hero-description">Cow is a web runtime for JavaScript and TypeScript.<br class="desktop-break"> Write server code inside your HTML, save the file, and refresh.</p>
      <div class="hero-actions"><a class="button button-primary" href="/docs/get-started">Get moooving <?= icon('arrow-line-right', 20) ?></a><a class="text-link" href="/docs/">Read the docs <?= icon('arrow-line-up-right', 20) ?></a></div>
      <p class="release-note">Free-range and open source · Still growing</p>
    </div>
  </section>
  <section class="how-section wrap" id="how" aria-labelledby="how-title">
    <div class="section-heading"><h2 id="how-title">Try it out.</h2></div>
      <div class="demo-shell" id="example">
        <div class="mascot-clip hero-cow" aria-hidden="true"><img src="/assets/doodles/cow-wave.svg" alt="" width="195" height="202" fetchpriority="high"></div>
        <div class="example-workbench">
          <div class="code-pane">
            <div class="pane-toolbar">
              <span class="filename"><?= icon('cow-file', 16) ?>hello.cow</span>
              <div class="example-switch js-only" role="group" aria-label="Example language">
                <button type="button" data-language="js" aria-pressed="true" aria-controls="source-js">JavaScript</button>
                <button type="button" data-language="ts" aria-pressed="false" aria-controls="source-ts">TypeScript</button>
              </div>
            </div>
            <pre class="source-code" id="source-js"><code><span class="token-muted">&lt;?js</span>
<span class="token-purple">const</span> name =
  req.<span class="token-blue">get</span>(<span class="token-green">'name'</span>) || <span class="token-green">'world'</span>
<span class="token-muted">?&gt;</span>

<span class="token-blue">&lt;h1&gt;</span>Hello, <span class="token-muted">&lt;?=</span> <span class="token-yellow">h</span>(name) <span class="token-muted">?&gt;</span>!<span class="token-blue">&lt;/h1&gt;</span></code></pre>
            <pre class="source-code" id="source-ts" hidden><code><span class="token-muted">&lt;?ts</span>
<span class="token-purple">const</span> name: <span class="token-yellow">string</span> =
  req.<span class="token-blue">get</span>(<span class="token-green">'name'</span>) || <span class="token-green">'world'</span>
<span class="token-muted">?&gt;</span>

<span class="token-blue">&lt;h1&gt;</span>Hello, <span class="token-muted">&lt;?=</span> <span class="token-yellow">h</span>(name) <span class="token-muted">?&gt;</span>!<span class="token-blue">&lt;/h1&gt;</span></code></pre>
            <div class="code-footer"><span>HTML + <span id="language-label">JavaScript</span></span><button class="copy-button js-only" type="button" id="copy-example">Copy code <?= icon('copy', 16) ?></button></div>
          </div>
          <div class="preview-pane">
            <div class="preview-toolbar"><?= icon('browser', 18) ?><span id="preview-address">/hello?name=world</span><span class="live-indicator" role="img" aria-label="Live example"><?= icon('checkmark', 14) ?></span></div>
            <?js if (annotationPreview) { ?>
            <div class="greeting-preview inline-preview" role="region" aria-label="Live Cow example output"><h1>Hello, world!</h1></div>
            <?js } else { ?>
            <iframe class="greeting-preview" title="Live Cow example output" name="greeting-preview" src="/hello?name=world" sandbox="allow-same-origin"></iframe>
            <?js } ?>
            <form class="example-form" action="/hello" method="get" <?js if (!annotationPreview) { ?>target="greeting-preview"<?js } ?>>
              <label for="visitor-name">Your name</label>
              <div class="example-input"><input id="visitor-name" name="name" value="world" maxlength="60" autocomplete="off" spellcheck="false"><button type="submit" aria-label="Run example"><?= icon('arrow-line-right', 20) ?></button></div>
            </form>
            <p class="preview-caption" id="preview-status" role="status"></p>
          </div>
        </div>

      </div>

    <div class="feature-row routes-feature">
      <div class="feature-copy"><h3>New page?<br>Just make a file.</h3><p>Add <code>about.cow</code> and visit <code>/about</code>. Cow handles the address for you.</p><a class="text-link" href="/docs/routing">See how pages work <?= icon('arrow-line-right', 20) ?></a></div>
      <div class="routes-illustration"><div class="mascot-clip route-cow" aria-hidden="true"><img src="/assets/doodles/cow-peek.svg" alt="" width="170" height="186" loading="lazy"></div><div class="file-window"><div class="light-toolbar"><?= icon('folder', 18) ?>site/</div><div class="route-row"><span class="file-name"><?= icon('cow-file', 18) ?>index.cow</span><span class="route-arrow" aria-hidden="true"><?= icon('arrow-line-right', 20) ?></span><code>/</code></div><div class="route-row"><span class="file-name"><?= icon('cow-file', 18) ?>about.cow</span><span class="route-arrow" aria-hidden="true"><?= icon('arrow-line-right', 20) ?></span><code>/about</code></div><div class="route-row"><span class="file-name"><?= icon('cow-file', 18) ?>blog/index.cow</span><span class="route-arrow" aria-hidden="true"><?= icon('arrow-line-right', 20) ?></span><code>/blog/</code></div><div class="route-row private-row"><span class="file-name"><?= icon('module', 18) ?>_greetings.cow</span><span class="private-label">Private module</span></div></div></div>
    </div>
  </section>

  <section class="support-section" id="supported" aria-labelledby="support-title"><div class="wrap">
    <div class="section-heading"><h2 id="support-title">JavaScript or TypeScript?</h2><p>Write Cow pages in either language. No separate build step.</p></div>
    <div class="language-logos" aria-label="Choose a language">
      <a href="/docs/language" aria-label="JavaScript support"><img src="/assets/brands/javascript.svg" alt="JavaScript" width="86" height="86" loading="lazy"></a>
      <a href="/docs/language#typescript" aria-label="TypeScript support"><img src="/assets/brands/typescript.svg" alt="TypeScript" width="86" height="86" loading="lazy"></a>
    </div>
  </div></section>

  <section class="packages-section" aria-labelledby="packages-title"><div class="wrap packages-layout">
    <img class="npm-mark" src="/assets/brands/npm.svg" alt="npm" width="130" height="65" loading="lazy">
    <div class="packages-copy"><h2 id="packages-title">Keep your favorite packages.</h2><p>Install from npm, then import packages in your Cow pages and modules.</p><a class="text-link" href="/docs/compatibility">How npm packages work <?= icon('arrow-line-right', 20) ?></a></div>
  </div></section>

  <section class="features-section wrap" aria-labelledby="features-title"><div class="section-heading"><h2 id="features-title">A well-stocked barn.</h2><p>The everyday tools for web apps come with the runtime. No assembly required.</p></div><div class="capability-grid">
    <?js for (const feature of features) { ?>
    <a class="capability" href="/docs/<?= h(feature.link) ?>"><h3><?= h(feature.title) ?> <?= icon('arrow-line-up-right', 20) ?></h3><p><?= h(feature.text) ?></p></a>
    <?js } ?>
  </div></section>

  <section class="runtime-section" id="runtimes" aria-labelledby="runtime-title"><div class="wrap"><div class="section-heading"><h2 id="runtime-title">Pick your pasture.</h2><p>Cow runs on Node.js, Bun, Nub, or Deno.</p></div>
    <div class="runtime-choices" role="group" aria-label="Choose a runtime">
    <?js for (const runtime of runtimes) { ?>
      <button type="button" class="runtime-choice" data-runtime="<?= h(runtime.id) ?>" aria-pressed="<?= runtime.id === 'node' ? 'true' : 'false' ?>" aria-controls="runtime-command"><img src="/assets/brands/<?= h(runtime.logo) ?>.svg" alt="" width="64" height="64" loading="lazy"><strong><?= h(runtime.name) ?></strong></button>
    <?js } ?>
    </div><div class="runtime-terminal"><span class="terminal-prompt" aria-hidden="true">$</span><code id="runtime-command">cow site --runtime node</code><button class="copy-button js-only" type="button" data-copy="runtime-command" aria-label="Copy runtime command">Copy <?= icon('copy', 16) ?></button></div><noscript><p class="compatibility-note">Use --runtime node, bun, nub, or deno.</p></noscript><p class="runtime-note"><a href="/docs/runtimes">Runtime support and setup <?= icon('arrow-line-right', 20) ?></a></p>
  </div></section>

  <section class="examples-section wrap" aria-labelledby="examples-title">
    <div class="examples-intro"><h2 id="examples-title">Out in<br>the field.</h2><a class="text-link" href="/examples/">Browse examples <?= icon('arrow-line-right', 20) ?></a></div>
    <div class="example-list">
      <div class="example-curious" aria-hidden="true"><img src="/assets/doodles/cow-curious.svg" alt="" width="159" height="207" loading="lazy"></div>
      <a href="/examples/mininews"><h3>MiniNews <?= icon('arrow-line-up-right', 20) ?></h3><p>A news editor with sign-in, drafts, and publishing.</p></a>
      <a href="/examples/forum"><h3>Forum <?= icon('arrow-line-up-right', 20) ?></h3><p>A place for discussions, replies, and member profiles.</p></a>
      <a href="/docs/forms"><h3>Your first form <?= icon('arrow-line-up-right', 20) ?></h3><p>Read a name from a form and say hello.</p></a>
    </div>
  </section>
</main>
<?= footer() ?>
</body></html>
