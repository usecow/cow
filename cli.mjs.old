#!/usr/bin/env -S node --no-warnings --experimental-vm-modules

// todo(niji): add support for plugins
import { PluginSystem } from './plugin.mjs'
import { Command, Option, Argument } from 'commander'
import { existsSync, readFileSync, statSync } from 'fs'
import { createServer } from 'http'
import { join, dirname, resolve, basename, extname } from 'path'
import { pathToFileURL, URL } from 'url'
import { Worker } from 'worker_threads'
import { pinoHttp } from 'pino-http'
import { pino } from 'pino'
import timeSpan from 'time-span'
import info from './package.json' assert { type: 'json' }
import send from 'send'

const regexImport = / from ["'](?<filepath>(?:\.?\/|\~\/)[^"']+)["'];?/gm
const regexStackFilename = /name=([^;]+)/
const regexStackPosition = /:(\d+):(\d+)/

const program = new Command();
const plugins = new PluginSystem()
const session = {}
const config = {}
const log = {}

const initializeConfig = () => {
  // server
  config.SERVER_ROOT_DIR = args.rootDir || './src'
  config.SERVER_HOST = args.host || 'localhost'
  config.SERVER_PORT = args.port || 8000

  // sessions
  config.SESSION_AUTOSTART = 0
  config.SESSION_DIR = '~/.jsr'
  config.SESSION_HANDLER = 'mm' // files | mm | user
  config.SESSION_COOKIE_NAME = 'JSRSESSION'
  config.SESSION_COOKIE_LIFETIME = 0
  config.SESSION_COOKIE_PATH = '/'
  config.SESSION_COOKIE_DOMAIN = ''
  config.SESSION_COOKIE_SECURE = 0
  config.SESSION_COOKIE_HTTPONLY = 0
  config.SESSION_COOKIE_SAMESITE = 0
  config.SESSION_GC_PROBABILITY = 1
  config.SESSION_GC_LIFETIME = 1440
  // mode
  // Todo(niji): eventually move mode to the module layer so that users can switch between ts / js
  config.MODE = 'js'
  config.MODE_JS_HYPERTEXT_EXT = '.jsp'
  config.MODE_JS_MODULE_EXT = '.mjs'
  config.MODE_TS_HYPERTEXT_EXT = '.tsp'
  config.MODE_TS_MODULE_EXT = '.ts'
  // logging
  config.LOG_FORMAT = 'tiny'
  config.LOG_ERR = true
  config.LOG_WARN = true
  config.LOG_DEBUG = false
  config.LOG_TIMINGS = true
  // compiler
  config.TAG_ECHO_OPEN = '<?='
  config.TAG_ECHO_CLOSE = '?>'
  config.TAG_CODE_OPEN_JS = '<?js'
  config.TAG_CODE_OPEN_TS = '<?ts'
  config.TAG_CODE_CLOSE = '?>'
  config.TAG_CLOSE = '?>'

  // Configure debug mode
  if (args.debug) {
    config.LOG_DEBUG = true;
  }

  // Configure logging errors
  if (!args.logErrors) {
    config.LOG_ERR = false
  }

  // Configure logging timings
  if (args.logTimings) {
    config.LOG_TIMINGS = args.logTimings
  }

  // Configure host
  if (args.host) {
    config.SERVER_HOST = args.host
  }

  // Configure port
  if (args.port) {
    config.SERVER_PORT = args.port
  }
}

const initializeSession = () => {
  session = {}
}

const initalizeLoggers = () => {
  log.cli = pino()
  log.http = pinoHttp({ logger: log.cli })
}

// Utilities
const pathHandler = (filepath) => {
  return join(config.SERVER_ROOT_DIR, filepath)
}

const pathExists = (filepath) => {
  return existsSync(filepath)
}

const pathRead = (filepath) => {
  return readFileSync(filepath, 'utf8')
}

const pathStat = (filepath) => {
  return statSync(filepath)
}

class ErrorHandler {
  constructor (response) {
    this.response = response
  }

  #send () {
    this.response.statusCode = this.code
    this.response.end(`
      <!DOCTYPE html>
      <html lang="en">
      <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>HTTP Status ${this.code} – ${this.title}</title>
        <style>
          body { font-family:Tahoma,Arial,sans-serif; }
          h1, h2, h3, b { color:white; background-color:#958275; }
          h1 { font-size:22px; }
          h2 { font-size:16px; }
          h3 { font-size:14px; }
          p { font-size:12px; }
          a { color:black; }
          hr { height:1px; background-color:#958275; border:none; }
        </style>
      </head>
      <body>
        <h1>HTTP Status ${this.code} – ${this.title}</h1>
        <hr />
        <p><b>message</b> ${this.message}</p>
        <hr />
        <h3>JavaScript Hypertext Preprocessor/${info.version}</h3>
      </body>
      </html>
    `)
  }

  NotFound() {
    this.code = 404
    this.title = 'File Not Found'
    this.message = 'The requested resource is not available.'
    return this.#send()
  }

  InternalServerError(message, stack) {
    this.code = 500
    this.title = 'Internal Server Error'
    this.message = 'The server encountered an internal error that prevented this request from being fulfilled.'
    log.http.logger.error({ err: { type: 'Error', message, stack } })
    return this.#send()
  }
}

class Module {
  static cache = {}

  static getExt() {
    return config.MODE === 'ts' 
    ? config.MODE_TS_HYPERTEXT_EXT 
    : config.MODE_JS_HYPERTEXT_EXT
  }

  static getImportExt() {
    return config.MODE === 'ts'
    ? config.MODE_TS_MODULE_EXT 
    : config.MODE_JS_MODULE_EXT
  }

  static new(path) {
    let module = Module.cache[path]

    if (!module) {
      module = new Module(path)
      Module.cache[path] = module
      return module
    }

    const stats = pathStat(path)
    if (module.lastModified < stats.mtime) {
      module = new Module(path)
      Module.cache[path] = module
      return module
    }

    module.timings = {}
    return module
  }

  constructor(path) {
    this.filepath = path
    this.#compile()
  }

  #getWorker(req, res) {
    this.#buildRequest(req)
    this.#buildResponse(res)

    return new Worker(new URL(
      `data:text/javascript;name=${this.filepath};base64,${this.codeBase64}`
    ), {
      workerData: {
        __filename: this.filename,
        __dirname: this.filedir,
        __req: this.request, 
        __res: this.response
      }
    })
  }

  #compile() {
    const timer = timeSpan()
    this.timings = {}
    this.#read()
    this.#tokenize()
    this.#build()
    this.timings.compile = timer() && timer.seconds()
  }

  #buildRequest(req) {
    this.request = {}

    // The API requires a fully qualified url, so we use the request host 
    // or fallback to `localhost` as a hack. Note: we only use this to get
    // the query string as an object
    this.url = new URL(`https://${req.host || 'localhost:3000'}/${req.url}`)

    // We do skips because maybe the user wants to do some custom
    // logic that we can't implement through other ways
    this.request._statusCode = false
    this.request._skipHeaders = false
    this.request._skipEnd = false

    // Build objects
    this.request._url = req.url
    this.request._params = Object.fromEntries(this.url.searchParams);
    this.request._session = {}
    this.request._headers = req.headers

    // Note: We need to handle different content types here later.
    this.request._body = req.body
  }

  #buildResponse(res) {
    this.response = {}
    this.response._statusCode = null
    this.response._headers = {}
  }

  #read() {
    const timer = timeSpan()
    this.stats = pathStat(this.filepath)
    this.content = pathRead(this.filepath)
    this.filedir = resolve(dirname(this.filepath))
    this.fileext = extname(this.filepath).substring(1)
    this.timings.read = timer() && timer.seconds()
  }

  #tokenize() {
    const timer = timeSpan()

    const { 
      TAG_ECHO_CLOSE, 
      TAG_ECHO_OPEN, 
      TAG_CODE_CLOSE, 
      TAG_CODE_OPEN_JS,
      TAG_CODE_OPEN_TS, 
      TAG_CLOSE 
    } = config
  
    const tokens = [];
    const text = this.content;
    const codeOpeningTag = config.MODE === 'ts' ? TAG_CODE_OPEN_TS : TAG_CODE_OPEN_JS
  
    let currentPosition = 0;
    while (currentPosition < text.length) {
      const echoOpeningTagIndex = text.indexOf(TAG_ECHO_OPEN, currentPosition)
      const codeOpeningTagIndex = text.indexOf(codeOpeningTag, currentPosition)
  
      const nextTags = [
        { type: 'ECHO_OPENING_TAG', value: TAG_ECHO_OPEN, index: echoOpeningTagIndex },
        { type: 'CODE_OPENING_TAG', value: codeOpeningTag, index: codeOpeningTagIndex }
      ]
  
      nextTags.sort((a, b) => a.index - b.index)
      const nextTag = nextTags.find(tag => tag.index !== -1)
  
      if (!nextTag) {
        tokens.push({ type: 'TEXT', value: text.slice(currentPosition) })
        break
      }
  
      if (currentPosition !== nextTag.index) {
        tokens.push({ type: 'TEXT', value: text.slice(currentPosition, nextTag.index) })
      }
  
      let closingTagIndex;
      let tokenType;
  
      switch (nextTag.type) {
        case 'ECHO_OPENING_TAG':
          closingTagIndex = text.indexOf(TAG_ECHO_CLOSE, nextTag.index + nextTag.value.length)
          tokenType = 'ECHO_BLOCK'
          break
        case 'CODE_OPENING_TAG':
          closingTagIndex = text.indexOf(TAG_CODE_CLOSE, nextTag.index + nextTag.value.length)
          tokenType = 'CODE_BLOCK'
          break
      }
  
      if (closingTagIndex === -1) {
        // NOTE !!  previously, this caught only for the first one
        //          now it catches for any trailing
        //          the code for the previous is below, just in case
        //          this new form doesn't work as intended...
        //
        // if (tokenType === 'CODE_BLOCK' && currentPosition === 0) {
        //   closingTagIndex = text.length
        // } else {
        //   throw new Error(`Missing closing tag for ${nextTag.type}`)
        // }
        //
        if (tokenType === 'CODE_BLOCK') {
          closingTagIndex = text.length
        }
      }
  
      const code = text.slice(nextTag.index + nextTag.value.length, closingTagIndex).trim()
      tokens.push({ type: tokenType, value: code })
      currentPosition = closingTagIndex + TAG_CLOSE.length
    }
  
    this.tokens = tokens
    this.timings.tokenize = timer() && timer.seconds()
  }

  #build () {
    const timer = timeSpan()
    const importExt = Module.getImportExt()

    // Initialize code array
    let code = []
  
    // Initialize module header
    code.push(`import { parentPort, workerData } from 'worker_threads';`)
    code.push(`const { __req, __res, __filename, __dirname } = workerData;`)
  
    // Initialize output
    code.push(`const req = {};`)
    code.push(`const res = {};`)
    code.push(`let _continue = true;`)
    code.push(`let output = "";`)
  
    // Initialize root methods
    code.push(`const ___exit = () => { try { parentPort.postMessage({ output, request: __req, response: __res, __filename, __dirname }); } catch (e) { throw new Error(e); } process.exit(); };`)
    code.push(`const die = () => { _continue = false; ___exit(); };`)
    code.push(`const echo = (...args) => { if (_continue) { output += args.join(' ') } };`)
  
    // Initialize request
    code.push(`req.url = () => __req._url;`)
    code.push(`req.headers = () => __req._headers;`)
    code.push(`req.header = (name) => __req._headers[name];`)
    code.push(`req.params = () => __req._params;`)
    code.push(`req.get = (name) => __req._params[name];`)
  
    // Initialize response
    code.push(`res.send = (input) => { output = input; die(); }`)
    code.push(`res.status = (code) => { __res._statusCode = code; };`)
    code.push(`res.setHeader = (name, value) => { __res._headers[name] = value; };`)
  
    // Iterate over tokens and output into module body
    for (const token of this.tokens) {
      if (token.type === 'TEXT') {
        code.push(`echo(\`${token.value.replace(/\`/g, '\\`')}\`);`)
      } else if (token.type === 'CODE_BLOCK') {
        // Hack for import statements
        let m
        while ((m = regexImport.exec(token.value)) !== null) {
          if (m.index === regexImport.lastIndex) {
            regexImport.lastIndex++;
          }
  
          let groupFilePath = m.groups.filepath
          let resolvedGroupFilePath = groupFilePath
  
          // add `.mjs` or `.ts` if not found
          if (groupFilePath.indexOf(importExt) < 0) {
            resolvedGroupFilePath += importExt
          }
  
          // resolve relative lookup
          if (groupFilePath.indexOf('./') === 0) {
            resolvedGroupFilePath = resolvedGroupFilePath.replace('./', '')
            resolvedGroupFilePath = join(this.filedir, resolvedGroupFilePath)
          }
  
          // resolve root lookup
          if (groupFilePath.indexOf('~/') === 0) {
            resolvedGroupFilePath = resolvedGroupFilePath.replace('~/', '')
            resolvedGroupFilePath = join(resolve(config.SERVER_ROOT_DIR), resolvedGroupFilePath)
          }
  
          token.value = token.value.replace(groupFilePath, pathToFileURL(resolvedGroupFilePath))
        }
  
        code.push(token.value + ';')
      } else if (token.type === 'ECHO_BLOCK') {
        code.push(`echo(String(${token.value}));`)
      }
    }
  
    // Finalize module
    code.push(`___exit();`)
  
    // Compile module
    code = code.join('\r\n')
  
    // debug
    log.http.logger.debug('module code', code)

    this.codeRaw = code
    this.codeBase64 = Buffer.from(code).toString('base64')
    this.timings.build = timer() && timer.seconds()
  }

  run (req, res) {
    const errorHandler = new ErrorHandler(res)
    const timer = timeSpan()
    const worker = this.#getWorker(req, res)

    worker.on('message', ({ output, request, response }) => {
      // Set headers on response
      for (const header in response._headers) {
        if (Object.hasOwnProperty.call(response._headers, header)) {
          const value = response._headers[header]
          request._skipHeaders = true
          res.setHeader(header, value)
        }
      }

      // Set status code
      if (response._statusCode) {
        request._skipStatusCode = true;
        res.statusCode = response._statusCode
      }

      // Handle defaults
      if (!request._skipStatusCode) res.statusCode = 200
      if (!request._skipHeaders) res.setHeader('Content-Type', 'text/html')

      // TODO(niji): figure out a way to support this again, can't pass functions to workers
      if (!request._skipEnd) res.end(output)

      // Stop the runtime timer
      this.timings.run = timer() && timer.seconds()

      // Output timers if allowed
      if (config.LOG_TIMINGS && this.timings.compile) {
        const timings = {}

        timings.msg = `compile time for ${this.filepath}`
        timings.filepath = `${this.filepath}`
        
        timings.read = `${this.timings.read}s`
        timings.tokenize = `${this.timings.tokenize}s`
        timings.build = `${this.timings.build}s`
        timings.compile = `${this.timings.compile}s`

        timings.elapsed = this.timings.compile * 1000

        log.http.logger.info(timings)
      }
    })

    worker.on('error', (err) => {
      let errMessage = err

      if (err.stack && err.stack.indexOf('data:') > -1) {
        let filename = ''
        let message = ''
        let line = 0
        let row = 0

        if (err.message) {
          const splitMessage = err.message ? err.message.split('\n') : ['Unknown']
          message = splitMessage[splitMessage.length - 1]
        }

        if (err.stack) {
          const stackFirstItem = err.stack.split('\n')[1]

          const stackMatchFilename = stackFirstItem.match(regexStackFilename)
          if (stackMatchFilename) {
            filename = stackMatchFilename[1]
          }

          const stackMatchPosition = stackFirstItem.match(regexStackPosition)
          if (stackMatchPosition) {
            line = Number(stackMatchPosition[2])
            row = Number(stackMatchPosition[1])
          }
        }

        errMessage = `Error: ${message}
          at ${filename}:${line}:${row}`
      }

      return errorHandler.InternalServerError(err.message, errMessage)
    })
  }
}

const getFilePath = (url) => {
  let isScript = false;
  let filepath;

  // Handle index files
  if (url[url.length - 1] === '/') {
    isScript = true;
    filepath = pathHandler(url + 'index' + Module.getExt());
  }

  // Handle non-index files
  if (url !== '/') {
    let rURL = new URL(`https://localhost/${url}`);
    let relativeFilePath = rURL.pathname;

    // No period? Add base extension
    if (relativeFilePath.indexOf('.') < 0) {
      isScript = true;
      relativeFilePath = relativeFilePath + Module.getExt();
    }

    filepath = pathHandler(relativeFilePath); 
  }

  return { isScript, filepath };
}

const requestHandler = async (req, res) => {
  log.http(req, res)

  const { url, method } = req
  const { isScript, filepath } = getFilePath(url);
  const errorHandler = new ErrorHandler(res)

  // Debugging
  log.http.logger.debug('compiling', url, filepath)

  // File doesn't exist on the server
  if (!pathExists(filepath)) {
    return errorHandler.NotFound(filepath)
  }

  // Handle Scripts
  if (isScript) {
    try {
      const module = Module.new(filepath)
      if (!module) {
        return errorHandler.InternalServerError(`Compilation of ${filepath} failed. Reason unknown.`);
      }

      module.run(req, res)
    } catch (err) {
      return errorHandler.InternalServerError(err.message, err.stack);
    }

    return
  }

  // Handle File Types
  if (method === 'GET') {
    send(req, filepath).pipe(res)
  } else {
    res.statusCode = 'OPTIONS' === method ? 200 : 405
    res.setHeader('Allow', 'GET, HEAD, OPTIONS')
    res.setHeader('Content-Length', '0')
    res.end()
  }
}

const initializeServer = () => {
  const server = createServer()
  server.on('request', requestHandler)
  server.listen(config.SERVER_PORT, config.SERVER_HOST, () => {
    log.cli.info({ msg: `Server running at http://${config.SERVER_HOST}:${config.SERVER_PORT}` })
  })
}

// Program
program
  .name(info.name)
  .description(info.description)
  .version(info.version);

// Setup program options
program
  .addArgument(new Argument('<directory>', 'directory').default(config.SERVER_ROOT_DIR).argOptional())
  .option(`--debug`, `output extra debug information`)
  .addOption(new Option(`--log-format <level>`, `set log format`).default(config.LOG_FORMAT).choices(['combined', 'common', 'dev', 'short', 'tiny']))
  .option(`--log-timings`, `output verbose request timings when logging`)
  .option(`--no-log-errors`, `don't output errors when logging`)
  .addOption(new Option(`-h, --host <host>`, `specify host to listen on`).default(config.SERVER_HOST).env('HOST'))
  .addOption(new Option(`-p, --port <port>`, `specify port to listen on`).default(config.SERVER_PORT).env('PORT'))
  .option(`-c, --config`, 'specify custom path to config file')
  .addOption(new Option(`-m, --mode <mode>`, `language mode`).default(config.MODE).choices(['js', 'ts']))
  .parse()

// Parse arguments
const args = program.opts()

initializeConfig()
initalizeLoggers()
initializeServer()