{
  "Print a value": { "prefix": "cowh", "body": "<?= ${1:value} ?>", "description": "Print a value; <?= ?> escapes it for HTML" },
  "Print trusted HTML": { "prefix": "cowraw", "body": "<?= raw(${1:html}) ?>", "description": "Print trusted HTML without escaping" },
  "Include with explicit locals": { "prefix": "cowinclude", "body": "await include('${1:./_part.jsp}', { ${2:title}: ${3:value} })", "description": "Await an include using explicit locals" },
  "JSON response": { "prefix": "cowjson", "body": "res.json({ ${1:ok}: ${2:true} })", "description": "Finish the request with JSON" },
  "Read form data": { "prefix": "cowform", "body": "const ${1:values} = await req.formData()", "description": "Read multipart or URL-encoded input" },
  "Explicit session update": { "prefix": "cowupdate", "body": "${1:current}.update({ ...${1:current}.data, ${2:theme}: ${3:'dark'} })", "description": "Save a session snapshot without rotating identity" }
}
