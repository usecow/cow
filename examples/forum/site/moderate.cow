<?js
import { HttpError, field } from 'cow:web'
import { context, methods, submitted, displayError } from './_auth.cow'
import { topic, post, number, moderate } from './_forum.cow'
methods(req, res)
const { current, user } = await context(req, res, { admin: true })
const id = number(req.get('id'))
const action = req.get('action')
if (!['lock', 'unlock', 'remove'].includes(action)) throw new HttpError(400, 'Unknown moderation action.')
const item = action === 'remove' ? post(id) : topic(id)
const topicId = action === 'remove' ? item.topic_id : id
const title = action === 'remove' ? 'Remove this post?' : action === 'lock' ? 'Lock this topic?' : 'Reopen this topic?'
let error = '', version = item.version
if (req.method() === 'POST') {
  try {
    const values = submitted(req, current)
    version = field(values, 'version')
    await moderate(user, action, id, values)
    res.redirect(`/topic?id=${topicId}`, 303)
  } catch (failure) { error = displayError(res, failure) }
}
await include('./_header.cow', { title, current, user })
?>
<div class="breadcrumb"><a href="/topic?id=<?= topicId ?>">← Back to the discussion</a></div>
<section class="panel editor">
  <p class="eyebrow">Administrator action</p><h1><?= title ?></h1><h2><?= h(item.title) ?></h2>
  <p class="muted"><?= action === 'remove' ? 'The post text will be erased and replaced with a removal notice. Replies stay in place. There is no undo.' : action === 'lock' ? 'Everyone can keep reading, but no one can reply or edit posts until you unlock the topic.' : 'Members will be able to reply and edit their own posts again.' ?></p>
  <?js if (action === 'remove' && item.removed_at === null) { ?><blockquote class="post-body"><?= h(item.body) ?></blockquote><?js } ?>
  <?js if (error) { ?><p class="error" role="alert"><?= h(error) ?></p><?js } ?>
  <form method="post" action="/moderate?action=<?= action ?>&amp;id=<?= id ?>">
    <input type="hidden" name="csrf" value="<?= h(current.csrfToken) ?>">
    <input type="hidden" name="version" value="<?= h(version) ?>">
    <label class="check"><input type="checkbox" name="confirm" value="yes" required> I confirm this <?= action === 'remove' ? 'removal' : 'change' ?>.</label>
    <div class="actions"><button type="submit" class="<?= action === 'remove' ? 'danger' : '' ?>"><?= action === 'remove' ? 'Remove post' : action === 'lock' ? 'Lock topic' : 'Unlock topic' ?></button><a href="/topic?id=<?= topicId ?>">Cancel</a></div>
  </form>
</section>
<?js await include('./_footer.cow') ?>
